{
  "name": "sd-webui-prompt-all-in-one",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite",
    "test": "node --run test:node",
    "test:node": "node --run test:node:target -- test/**/*.node-test.js test/**/*.node-test.ts",
    "test:node:target": "node --run typecheck:all && tsx --test --test-update-snapshots --",
    "posttest": "pnpm run build",
    "build": "vite build",
    "build:all": "pnpm run build && node --run build:css",
    "build:css": "node build-css.js all",
    "build:css:main": "node build-css.js main",
    "build:css:extensions": "node build-css.js extensions",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "typecheck:test": "cd test && vue-tsc --noEmit & echo Type checking completed (test)",
    "typecheck:all": "node --run typecheck && node --run typecheck:test",
    "typecheck": "vue-tsc --noEmit & echo Type checking completed (main)"
  },
  "dependencies": {
    "autosize-input": "^1.0.2",
    "axios": "^1.20.0",
    "js-yaml": "^5.4.3",
    "papaparse": "^5.7.0",
    "sort-object-keys2": "^3.0.10",
    "sortablejs": "^1.15.7",
    "tinycolor2": "^1.6.0",
    "tippy.js": "^6.3.7",
    "toastr": "^2.1.4",
    "ts-type": "^3.0.18",
    "vue": "^3.5.44",
    "vue-clipboard3": "^2.0.0",
    "vue3-colorpicker": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "less": "^4.9.1",
    "less-loader": "^13.0.0",
    "less-plugin-clean-css": "^1.6.0",
    "sass": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3 <7",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
